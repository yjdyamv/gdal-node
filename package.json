{
  "name": "gdal-async",
  "version": "3.12.3",
  "description": "Bindings to GDAL (Geospatial Data Abstraction Library) with full async support",
  "license": "Apache-2.0",
  "url": "https://github.com/mmomtchev/node-gdal-async",
  "main": "./lib/gdal.js",
  "types": "./lib/index.d.ts",
  "type": "commonjs",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "import": "./lib/gdal.mjs",
      "require": "./lib/gdal.js",
      "default": "./lib/gdal.js"
    },
    "./package.json": "./package.json",
    "./lib/*": "./lib/*"
  },
  "keywords": [
    "gdal",
    "libgdal",
    "ogr",
    "gis",
    "geo",
    "geos",
    "geography",
    "geospatial",
    "raster",
    "vector",
    "gtiff",
    "geojson",
    "mapping"
  ],
  "binary": {
    "module_name": "gdal",
    "module_path": "./lib/binding/napi-v8-{platform}-{arch}",
    "remote_path": "v{version}",
    "host": "https://github.com/yjdyamv/node-gdal-async/releases/download/",
    "package_name": "napi-v8-{platform}-{arch}.tar.gz"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/mmomtchev/node-gdal-async.git"
  },
  "funding": {
    "url": "https://github.com/sponsors/mmomtchev",
    "type": "individual"
  },
  "contributors": [
    {
      "name": "Brandon Reavis",
      "url": "https://github.com/brandonreavis",
      "email": "brandon@naturalatlas.com"
    },
    {
      "name": "Momtchil Momtchev",
      "url": "https://github.com/mmomtchev",
      "email": "momtchil@momtchev.com"
    }
  ],
  "scripts": {
    "test": "npm run lint:js && tsc --noEmit && npm run iterators -- --check && npm run yatag -- --check && npm run test:parallel && npm run test:stress 20",
    "bench": "node bench/streams.js",
    "build": "node scripts/build.mjs",
    "clean": "cmake-js clean",
    "package": "node scripts/package.mjs",
    "lint:cpp": "clang-format -i src/*.cpp src/*.hpp && clang-format -i src/*/*.cpp src/*/*.hpp",
    "lint:js": "eslint lib test examples .mocharc.js",
    "lint:fix": "eslint lib test examples --fix",
    "lint": "npm run lint:js && npm run lint:cpp",
    "install": "node scripts/install.mjs",
    "postinstall": "node scripts/motd",
    "yatag": "node scripts/generate-typings.js",
    "iterators": "node scripts/generate-default-iterators.js",
    "doc:build": "npm run yatag && npx typedoc",
    "doc:publish": "npm run doc:build && node ./scripts/publish-docs.js",
    "preversion": "npm run lint && npm run yatag && npm run doc:build && npm run test",
    "gcov": "mkdir -p coverage && cd coverage && gcov -o ../build/CMakeFiles/gdal.dir/src ../src/*",
    "lcov": "npx c8 report --reporter=text-lcov > coverage/tests.lcov",
    "codecov": "cd coverage && curl -s https://codecov.io/bash | bash",
    "version": "git add package.json",
    "postversion": "git push && git push --tags && node ./scripts/publish-packages.mjs && npm run doc:publish",
    "container": "bash scripts/container.sh",
    "test:u22": "npm run container dev ubuntu:22.04 22",
    "test:u24": "npm run container dev ubuntu:24.04 24",
    "test:trixie": "npm run container dev debian:trixie 24",
    "test:c10": "npm run container dev centos:stream10 24",
    "test:arch": "npm run container dev archlinux:latest 24",
    "test:f42": "npm run container dev fedora:42 24",
    "test:distros": "npm run test:u22 && npm run test:c10 && npm run test:f42",
    "test:clean": "npx rimraf test/data/*.tmp* test/data/temp/*",
    "test:stress": "node test/stress",
    "test:parallel": "mocha --parallel --jobs 4",
    "test:coverage": "c8 npm run test:parallel",
    "postpublish": "gh workflow run test-npm.yml -F version=$npm_package_version"
  },
  "dependencies": {
    "@petamoriken/float16": "^3.9.2",
    "cmake-js": "^8.0.0",
    "node-addon-api": "^8.5.0",
    "xmlbuilder2": "^4.0.0",
    "yatag": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.1.0",
    "@eslint/js": "^10.0.1",
    "@mmomtchev/node-pre-gyp-github": "^2.0.0",
    "@octokit/core": "^7.0.2",
    "@types/chai": "^4.2.18",
    "@types/chai-as-promised": "^7.1.5",
    "@types/mocha": "^10.0.6",
    "@types/node": "^25.0.0",
    "@types/semver": "^7.3.9",
    "@types/ungap__structured-clone": "^1.2.0",
    "@typescript-eslint/eslint-plugin": "^8.0.1",
    "@typescript-eslint/parser": "^8.0.1",
    "@ungap/structured-clone": "^1.2.0",
    "aws-sdk": "^2.1130.0",
    "benny": "^3.7.1",
    "c8": "^11.0.0",
    "chai": "^4.2.0",
    "chai-as-promised": "^7.1.1",
    "eslint": "^10.0.0",
    "eslint-plugin-array-func": "^4.0.0",
    "eslint-plugin-mocha": "^11.0.0",
    "eslint-plugin-prefer-arrow": "^1.1.3",
    "gh-pages": "^6.1.1",
    "globals": "^17.0.0",
    "mocha": "^11.0.1",
    "semver": "^7.3.5",
    "tsconfig-paths": "^4.0.0",
    "tsx": "^4.20.5",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": ">=22"
  }
}
