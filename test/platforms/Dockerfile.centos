ARG VERSION=stream10
FROM quay.io/centos/centos:${VERSION}

ARG NODEJS=lts

RUN \
  dnf -y install dnf-plugins-core && \
  dnf install -y epel-release && \
  dnf config-manager --enable crb && \
  dnf config-manager --save --setopt="epel*.priority=1" && \
  dnf install -y rsync && \
  curl -fsSL https://rpm.nodesource.com/setup_${NODEJS}.x | bash - && \
  dnf install -y nodejs && \
  dnf groupinstall -y 'Development Tools' && \
  dnf install -y git python3 ccache && \
  mkdir -p /target && chmod 777 /target

RUN dnf install -y python3-pip && (pip3 install --break-system-packages conan || pip3 install conan)

COPY entrypoint.sh /

ENTRYPOINT ["/entrypoint.sh"]
