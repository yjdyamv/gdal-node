ARG VERSION=trixie
FROM debian:${VERSION}

ARG NODEJS=lts

RUN \
  DEBIAN_FRONTEND=noninteractive apt-get update && \
  DEBIAN_FRONTEND=noninteractive apt-get install -y curl rsync ca-certificates curl gnupg && \
  curl -fsSL https://deb.nodesource.com/setup_${NODEJS}.x -o nodesource_setup.sh && \
  bash nodesource_setup.sh && \
  DEBIAN_FRONTEND=noninteractive apt-get install -y nodejs && \
  DEBIAN_FRONTEND=noninteractive apt-get install -y python3 git build-essential ccache && \
  mkdir -p /target && chmod 777 /target

RUN DEBIAN_FRONTEND=noninteractive apt-get install -y python3-pip && (pip3 install --break-system-packages conan || pip3 install conan)

COPY entrypoint.sh /

ENTRYPOINT ["/entrypoint.sh"]
