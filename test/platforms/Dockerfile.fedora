ARG VERSION=42
FROM fedora:${VERSION}

ARG NODEJS=lts

RUN \
  dnf install -y curl rsync && \
  curl -fsSL https://rpm.nodesource.com/setup_${NODEJS}.x | bash - && \
  dnf install -y nodejs && \
  dnf group install -y development-tools && \
  dnf install -y g++ git python ccache && \
  mkdir -p /target && chmod 777 /target

RUN dnf install -y python3-pip && (pip3 install --break-system-packages conan || pip3 install conan)

COPY entrypoint.sh /

ENTRYPOINT ["/entrypoint.sh"]
