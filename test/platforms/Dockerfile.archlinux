ARG VERSION=latest
FROM archlinux:${VERSION}

ARG NODEJS=lts
ENV USER=root

RUN \
  pacman --noconfirm -Syu && \
  pacman --noconfirm -Sy base-devel git rsync ccache && \
  pacman --noconfirm -Sy nodejs npm && \
  mkdir -p /target && chmod 777 /target

RUN pacman --noconfirm -Sy python-pip && (pip3 install --break-system-packages "conan==2.33.0" || pip3 install "conan==2.33.0")

COPY entrypoint.sh /

ENTRYPOINT ["/entrypoint.sh"]
