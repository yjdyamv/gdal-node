# The profile the CI uses on Windows arm64 (windows-11-arm).
#
# It is not detected, but pinned: Conan reuses the binaries published by
# conan-center only for the exact compiler that built them, and conan-center
# has published Windows arm64 binaries with the MSVC of Visual Studio 2022,
# the "194" of Conan, since October 2025.  Do not bump it to the toolset of
# the runner image: the windows-11-arm image has moved to the MSVC 14.50 of
# Visual Studio 2026, which has no binaries on conan-center, and the 14.x
# toolsets are ABI compatible - Microsoft guarantees it back to Visual Studio
# 2015 - so the 14.50 compiler links against the 194 binaries without
# rebuilding anything.  Conan activates the arm64 build tools by itself,
# there is no need for a Developer Command Prompt.
[settings]
os=Windows
arch=armv8
compiler=msvc
compiler.version=194
compiler.cppstd=20
compiler.runtime=dynamic
build_type=Release

[conf]
# Without this Conan uses the MSBuild generator, which is visibly slower on a
# build as large as the ~1300 translation units of GDAL.  GDAL is always built
# from source here: the recipe of conan/recipes/gdal carries the ExprTk and
# muparser options of the addon, so no binary of it exists on conan-center.
# Ninja is part of the runner image; when using this profile by hand, install
# it first.
tools.cmake.cmaketoolchain:generator=Ninja

# Conan looks for the installation of the Visual Studio that the compiler
# version of the profile belongs to - the 17 of the 194 - and there is none on
# the runner anymore: the windows-11-arm image has moved to Visual Studio 2026.
# Point Conan at the installation that exists, the 14.4x arm64 toolset of the
# 2022 is installed next to the 2026 and will be the one selected, so the
# binaries are still those of the conan-center MSVC 194.
tools.microsoft.msbuild:vs_version=18

[buildenv]
# Several dependencies still declare compatibility with CMake < 3.5, which
# CMake 4 rejects outright when it has to build them from source.  Only the
# environment variable is honored by those projects.
CMAKE_POLICY_VERSION_MINIMUM=3.5
