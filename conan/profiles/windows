# The profile the CI uses on Windows.
#
# It is not detected, but pinned: Conan reuses the binaries published by
# conan-center only for the exact compiler that built them.
# Keep the compiler in sync with the runner image of the workflow: the
# windows-2022 image ships Visual Studio 2022 17.14 (MSVC 19.44), which is
# the "194" of Conan.
[settings]
os=Windows
arch=x86_64
compiler=msvc
compiler.version=194
compiler.cppstd=20
compiler.runtime=dynamic
build_type=Release

[conf]
# Without this Conan uses the MSBuild generator, which is visibly slower on a
# build as large as the ~1300 translation units of GDAL.  GDAL is always built
# from source here: the recipe of conan/recipes/gdal carries the ExprTk and
# muparser options of the addon, so no binary of it exists on conan-center.
# Conan activates the environment of Visual Studio by itself, there is no need
# for a Developer Command Prompt.  Ninja is part of the runner image; when
# using this profile by hand, install it first.
tools.cmake.cmaketoolchain:generator=Ninja

[buildenv]
# Several dependencies still declare compatibility with CMake < 3.5, which
# CMake 4 rejects outright when it has to build them from source.  Only the
# environment variable is honored by those projects.
CMAKE_POLICY_VERSION_MINIMUM=3.5
